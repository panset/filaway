# Copy to Tools/release.env (gitignored) and fill in. Tools/lib.sh loads it for
# every script under Tools/; anything already exported wins, so CI can set the
# same names as secrets without a file. See docs/release.md.

# The Developer ID Application certificate, exactly as `security find-identity
# -v -p codesigning` prints it. Leave unset to keep ad-hoc signing.
#DEVELOPER_ID="Developer ID Application: Tejas Panse (ABCDE12345)"

# Sparkle's EdDSA public key, printed by Tools/sparkle/generate_keys.sh.
# Tools/make_app.sh writes it into Info.plist as SUPublicEDKey; without it the
# build cannot update itself and the menu item stays disabled.
#SPARKLE_PUBLIC_KEY="base64…"

# Only needed if the private key is NOT in this machine's login Keychain — for
# example on a build box. Normally leave this unset and let generate_appcast
# read the Keychain.
#SPARKLE_PRIVATE_KEY="base64 of the 32-byte ed25519 seed"

# notarytool keychain profile, created once with:
#   xcrun notarytool store-credentials "filaway-notary" \
#     --apple-id you@example.com --team-id ABCDE12345 --password <app-specific>
#NOTARY_PROFILE="filaway-notary"

# Or an App Store Connect API key instead of the profile (what CI uses).
#NOTARY_KEY_ID="XXXXXXXXXX"
#NOTARY_ISSUER_ID="00000000-0000-0000-0000-000000000000"
#NOTARY_KEY_P8="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"

# Override the appcast URL baked into Info.plist. Changing this after the first
# public release strands everyone already running the old one.
#SUFEED_URL="https://tejaspanse.github.io/filaway/appcast.xml"
